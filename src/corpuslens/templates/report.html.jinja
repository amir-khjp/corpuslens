<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ report.title }}</title>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4"></script>
<style>
  :root {
    --bg: #0f1117; --panel: #171a23; --border: #2a2e3a; --text: #e7e9ee;
    --muted: #9aa0ad; --accent: #6ea8fe; --warn: #f5a623; --good: #4ade80;
  }
  @media (prefers-color-scheme: light) {
    :root { --bg: #f7f8fa; --panel: #ffffff; --border: #e3e5ea; --text: #1c1f27; --muted: #5b6270; }
  }
  * { box-sizing: border-box; }
  body {
    margin: 0; background: var(--bg); color: var(--text);
    font-family: -apple-system, Segoe UI, Roboto, Helvetica, Arial, sans-serif;
    padding: 24px; max-width: 1100px; margin-inline: auto;
  }
  h1 { font-size: 1.6rem; margin-bottom: 4px; }
  .subtitle { color: var(--muted); margin-bottom: 24px; }
  .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 12px; margin-bottom: 16px; }
  .stat { background: var(--panel); border: 1px solid var(--border); border-radius: 10px; padding: 12px 14px; }
  .stat .value { font-size: 1.4rem; font-weight: 600; }
  .stat .label { color: var(--muted); font-size: 0.8rem; }
  section { background: var(--panel); border: 1px solid var(--border); border-radius: 12px; padding: 20px; margin-bottom: 20px; }
  section h2 { margin-top: 0; font-size: 1.1rem; }
  .warn { background: rgba(245, 166, 35, 0.12); border: 1px solid var(--warn); border-radius: 8px; padding: 8px 12px; margin: 6px 0; font-size: 0.9rem; }
  table { width: 100%; border-collapse: collapse; font-size: 0.85rem; margin-top: 10px; }
  th, td { text-align: left; padding: 6px 8px; border-bottom: 1px solid var(--border); }
  canvas { max-height: 280px; }
  .badge { display: inline-block; padding: 2px 8px; border-radius: 999px; background: var(--border); font-size: 0.75rem; color: var(--muted); }
</style>
</head>
<body>
  <h1>{{ report.title }}</h1>
  <div class="subtitle">
    {{ report.n_rows }} rows &middot; text column: <span class="badge">{{ report.text_col }}</span>
    {% if report.label_col %}&middot; label column: <span class="badge">{{ report.label_col }}</span>{% endif %}
  </div>

  {% for analyzer in report.analyzers %}
  <section>
    <h2>{{ analyzer.name | replace("_", " ") | title }}</h2>

    {% for w in analyzer.warnings %}
    <div class="warn">&#9888; {{ w }}</div>
    {% endfor %}

    <div class="grid">
      {% for key, value in analyzer.summary.items() %}
        {% if value is not mapping and value is not sequence or value is string %}
        <div class="stat">
          <div class="value">{{ value }}</div>
          <div class="label">{{ key | replace("_", " ") }}</div>
        </div>
        {% endif %}
      {% endfor %}
    </div>

    {% for chart in analyzer.charts %}
    <canvas id="chart-{{ analyzer.name }}-{{ loop.index }}"></canvas>
    <script>
      new Chart(document.getElementById("chart-{{ analyzer.name }}-{{ loop.index }}"), {
        type: {{ ("pie" if chart.kind == "pie" else ("line" if chart.kind == "histogram" else "bar")) | tojson }},
        data: {
          labels: {{ chart.labels | tojson }},
          datasets: [{
            label: {{ chart.title | tojson }},
            data: {{ chart['values'] | tojson }},
            backgroundColor: ["#6ea8fe","#4ade80","#f5a623","#f87171","#c084fc","#22d3ee","#fbbf24","#a3e635"],
            borderColor: "#6ea8fe",
            borderWidth: 1,
          }]
        },
        options: { responsive: true, plugins: { title: { display: true, text: {{ chart.title | tojson }} } } }
      });
    </script>
    {% endfor %}

    {% if analyzer.table %}
    <table>
      <thead><tr>{% for key in analyzer.table[0].keys() %}<th>{{ key }}</th>{% endfor %}</tr></thead>
      <tbody>
        {% for row in analyzer.table %}
        <tr>{% for value in row.values() %}<td>{{ value }}</td>{% endfor %}</tr>
        {% endfor %}
      </tbody>
    </table>
    {% endif %}
  </section>
  {% endfor %}

  <div class="subtitle">Generated by <a href="https://github.com/yourusername/corpuslens" style="color: var(--accent);">CorpusLens</a></div>
</body>
</html>
